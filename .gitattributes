# 개행 정규화: 저장소에는 LF로 저장 (Windows/Mac/Linux 혼용 대비)
* text=auto

# 리눅스 서버에서 실행되는 스크립트는 반드시 LF
*.sh text eol=lf

# Windows 배치 파일은 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
*.gz binary
*.der binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
