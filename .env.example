# 실행 환경 — local | development | staging | production
# 미설정 시 NODE_ENV 로 추정한다(production 이면 production, 그 외 local).
# ★ mock 결제(/api/donations/*/init 즉시 완료)는 local·development 에서만 허용된다.
APP_ENV="local"

# 앞단 프록시(ALB/Nginx) 단 수. 로그인 실패 제한용 클라이언트 IP를
# X-Forwarded-For 의 뒤에서 이 수만큼 떨어진 값으로 신뢰한다. (스푸핑 방어)
TRUSTED_PROXY_HOPS="1"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donation_platform"

# Auth
NEXTAUTH_URL="http://localhost:3005"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# 앱 공개 URL (QR 코드 링크 생성용)
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# 인포뱅크 문자후원 (실제 연동 시 교체)
INFOBANK_PROVIDER="mock"            # mock | live
INFOBANK_API_BASE_URL=""
INFOBANK_API_KEY=""
INFOBANK_API_SECRET=""
INFOBANK_WEBHOOK_SECRET=""

# 온기 간편 계좌이체 / 정기후원 (실제 연동 시 교체)
ONKI_PROVIDER="mock"                # mock | live
ONKI_API_BASE_URL=""
ONKI_API_KEY=""
ONKI_API_SECRET=""
ONKI_WEBHOOK_SECRET=""

# 소셜 로그인 — 각 플랫폼 개발자 콘솔에서 발급
# Google: https://console.cloud.google.com → OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kakao: https://developers.kakao.com → 내 애플리케이션
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Naver: https://developers.naver.com → 애플리케이션 등록
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ── 온기(ONGI/핵토파이낸셜) 내통장결제 (간편 계좌이체) ──
# 실동작하려면 ONGI_PROVIDER=live 로 바꾸고 아래 값을 채우세요.
ONGI_PROVIDER=mock
ONGI_QR_CODE=            # 플랫폼 공용 가맹점 QR코드 (pay.ongi.site/#/qr/{여기})
ONGI_PAY_BASE_URL=https://pay.ongi.site
ONGI_CALLBACK_SECRET=    # 콜백 ref 위조방지용 임의 시크릿 (예: openssl rand -hex 32)
                         # ★ 폴백 상수("dev-secret")를 제거했습니다. ONGI_PROVIDER=live 면 필수.
# NEXT_PUBLIC_APP_URL 은 콜백/복귀 URL 생성에 사용됩니다(실제 접속 도메인).

# ── 계정 초기화 스크립트용 (앱 런타임에서는 쓰지 않음) ──
# 저장소에 평문 비밀번호를 두지 않기 위해, 스크립트 실행 시에만 주입합니다.
# ADMIN_INITIAL_PASSWORD=
# ORG_ADMIN_INITIAL_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_ORG_PASSWORD=
