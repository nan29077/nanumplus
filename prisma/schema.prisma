generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
}

enum DonationChannel {
  SMS
  EASY_TRANSFER      // 핵토 내통장결제(간편 계좌이체)
  RECURRING_TRANSFER // 계좌 자동이체 정기후원
  RECURRING_CARD     // 신용카드 정기후원(핵토 빌링키)
}

enum RecurringMethod {
  TRANSFER // 계좌 자동이체
  CARD     // 카드 빌링키
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
  CLOSED
}

enum SettlementStatus {
  PENDING     // 정산 대기
  PROCESSING  // 처리 중
  COMPLETED   // 정산 완료
  CANCELLED   // 취소
}

// ───────────────────────── Models ─────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String?
  role           UserRole  @default(ORG_ADMIN)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationAdmin OrganizationAdmin?
  auditLogs         AuditLog[]
  accounts          Account[]
  sessions          Session[]
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  logoUrl       String?
  description   String?
  address       String?
  phone         String?
  email         String?
  smsBaseNumber String    @default("#2540")
  smsCode       String?   @unique // 4자리 숫자
  smsFullNumber String?   @unique // 예: #2540-1234 (대시 포함)
  qrCodeUrl     String?
  // 정산 계좌 정보
  bankName      String?   // 은행명 (예: 국민은행)
  bankAccount   String?   // 계좌번호
  bankHolder    String?   // 예금주
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admins             OrganizationAdmin[]
  smsAssignments     SmsNumberAssignment[]
  donors             Donor[]
  donations          Donation[]
  recurringDonations RecurringDonation[]
  campaigns          Campaign[]
  qrCodes            QrCode[]
  settlements        Settlement[]
  fees               OrganizationFee[]
  donationPage       DonationPage?
  billingKeys        BillingKey[]
}

model OrganizationAdmin {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model SmsNumberAssignment {
  id             String    @id @default(cuid())
  organizationId String
  baseNumber     String    @default("#2540")
  code           String // 4자리
  // 배정 이력 테이블이므로 fullNumber에 전역 unique를 걸지 않는다.
  // (걸면 번호 회수 후 다른 기관에 재배정할 수 없음)
  // 현재 유효한 배정의 유일성은 isActive=true 부분 유니크 인덱스 +
  // 애플리케이션 레벨 사전 검사로 보장한다.
  fullNumber     String
  assignedById   String?
  isActive       Boolean   @default(true)
  assignedAt     DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([fullNumber, isActive])
}

model Donor {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  phone           String?
  email           String?
  memo            String?
  privacyConsent  Boolean   @default(false)
  isRecurring     Boolean   @default(false)
  donorAccountId  String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donations          Donation[]
  recurringDonations RecurringDonation[]
  donorAccount       DonorAccount?       @relation(fields: [donorAccountId], references: [id], onDelete: SetNull)
  billingKeys        BillingKey[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([donorAccountId])
}

model Donation {
  id                    String          @id @default(cuid())
  organizationId        String?          // null = 기관 미매핑 SMS (기관배정 없음)
  donorId               String?
  donorAccountId        String?
  campaignId            String?
  channel               DonationChannel
  amount                Int // KRW (SMS는 항상 3000)
  status                DonationStatus  @default(PENDING)
  donatedAt             DateTime        @default(now())
  providerTransactionId String?         @unique
  providerName          String? // infobank | onki
  memo                  String?
  smsBody               String?         // 후원자가 보낸 문자 내용 (SMS 채널 전용)
  senderPhone           String?         // 발신자 전화번호 (SMS 채널 전용)
  recipientNumber       String?         // 수신 번호 원본 (기관 미배정 SMS용)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  donor           Donor?           @relation(fields: [donorId], references: [id], onDelete: SetNull)
  donorAccount    DonorAccount?    @relation(fields: [donorAccountId], references: [id], onDelete: SetNull)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  settlementItems SettlementItem[]

  @@index([organizationId, donatedAt])
  @@index([organizationId, channel])
  @@index([donorAccountId])
  @@index([campaignId])
  @@index([channel, status, donatedAt])   // 채널별 관리자 조회 최적화
  @@index([status, donatedAt])            // 상태별 필터링 최적화
  @@index([deletedAt, donatedAt])         // deletedAt IS NULL 쿼리 최적화
}

model RecurringDonation {
  id                 String          @id @default(cuid())
  organizationId     String
  donorId            String
  amount             Int
  dayOfMonth         Int             @default(25)
  method             RecurringMethod @default(TRANSFER)
  status             RecurringStatus @default(ACTIVE)
  providerContractId String?         @unique
  billingKeyId       String?
  donorAccountId     String?
  startedAt          DateTime        @default(now())
  cancelledAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donor        Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  donorAccount DonorAccount? @relation(fields: [donorAccountId], references: [id], onDelete: SetNull)
  billingKey   BillingKey?   @relation(fields: [billingKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([donorAccountId])
}

model Campaign {
  id              String         @id @default(cuid())
  organizationId  String
  title           String
  slug            String         @unique
  coverImageUrl   String?
  goalAmount      Int
  currentAmount   Int            @default(0)
  startDate       DateTime
  endDate         DateTime
  summary         String?
  story           String?
  reason          String?
  usagePlan       String?
  beneficiary     String?
  messageToDonors  String?
  allowedChannels  String?        @db.Text // JSON: ["SMS","EASY_TRANSFER","RECURRING_TRANSFER"]
  status           CampaignStatus @default(DRAFT)
  isPublished      Boolean        @default(false)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  images       CampaignImage[]
  donations    Donation[]

  @@index([organizationId])
}

model CampaignImage {
  id         String   @id @default(cuid())
  campaignId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model QrCode {
  id             String    @id @default(cuid())
  organizationId String
  targetUrl      String
  imageDataUrl   String // data:image/png;base64
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String // infobank | onki
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([provider, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // 예: ORGANIZATION_CREATE
  entityType String?
  entityId   String?
  detail     Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

// ───────────────────────── 정산 ─────────────────────────

model Settlement {
  id             String           @id @default(cuid())
  organizationId String
  period         String           // "2026-04" (YYYY-MM) 정산 월
  scheduledDate  DateTime         // 정산 예정일 (해당 월 16일)
  totalAmount    Int              @default(0) // 총 후원금액
  feeAmount      Int              @default(0) // 수수료
  netAmount      Int              @default(0) // 실지급액 (totalAmount - feeAmount)
  status         SettlementStatus @default(PENDING)
  processedAt    DateTime?        // 처리 완료 일시
  bankName       String?          // 처리 시점 계좌 스냅샷
  bankAccount    String?
  bankHolder     String?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        SettlementItem[]

  @@unique([organizationId, scheduledDate])
  @@index([organizationId, period])
  @@index([organizationId])
  @@index([scheduledDate])
  @@index([status])
}

// 기관별 후원 채널 수수료 설정
model OrganizationFee {
  id             String          @id @default(cuid())
  organizationId String
  channel        DonationChannel
  feePercent     Float           @default(5.0) // 수수료율 (%)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
  @@index([organizationId])
}

model SettlementItem {
  id           String   @id @default(cuid())
  settlementId String
  donationId   String   @unique
  amount       Int
  channel      String
  donatedAt    DateTime
  createdAt    DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  donation   Donation   @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}


// ───────────────────────── 후원자 계정 (플랫폼 통합) ─────────────────────────

model DonorAccount {
  id           String    @id @default(cuid())
  provider     String    // kakao | naver | google | credentials
  providerId   String    // 공급자 사용자 고유 ID
  email        String?
  name         String?
  phone        String?
  profileImage String?
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  donorProfiles      Donor[]
  donations          Donation[]
  recurringDonations RecurringDonation[]
  billingKeys        BillingKey[]

  @@unique([provider, providerId])
  @@index([email])
  @@index([phone])
}

// ───────────────────────── 후원페이지 빌더 설정 ─────────────────────────

model DonationPage {
  id               String   @id @default(cuid())
  organizationId   String   @unique

  // 테마 / 히어로
  themeColor       String   @default("#2f8f5b")
  heroImageUrl     String?
  heroTitle        String?
  heroSubtitle     String?

  // 소개 / 스토리
  introTitle       String?
  introBody        String?  @db.Text
  blocks           String?  @db.Text // JSON: [{type,heading,body,imageUrl,caption}]

  // 후원 옵션
  suggestedAmounts String?  @db.Text // JSON: [10000,30000,50000]
  enabledChannels  String?  @db.Text // JSON: ["SMS","EASY_TRANSFER","RECURRING_TRANSFER","RECURRING_CARD"]

  // 감사 메시지
  thankYouTitle    String?
  thankYouMessage  String?  @db.Text

  // 노출 토글
  showStats        Boolean  @default(true)
  showCampaigns    Boolean  @default(true)
  showFaq          Boolean  @default(false)

  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ───────────────────────── 카드 빌링키 (정기후원) ─────────────────────────

model BillingKey {
  id             String    @id @default(cuid())
  organizationId String
  donorAccountId String?
  donorId        String?
  provider       String    @default("hecto")
  billingKeyRef  String    // 공급자 빌링키 토큰/참조값 (평문 카드정보 저장 금지)
  cardIssuer     String?   // 카드사
  cardLast4      String?   // 카드 끝 4자리
  status         String    @default("ACTIVE") // ACTIVE | PAUSED | DELETED | FAILED
  issuedAt       DateTime  @default(now())
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donorAccount       DonorAccount?       @relation(fields: [donorAccountId], references: [id], onDelete: SetNull)
  donor              Donor?              @relation(fields: [donorId], references: [id], onDelete: SetNull)
  recurringDonations RecurringDonation[]

  @@index([organizationId])
  @@index([donorAccountId])
  @@index([donorId])
}

// ───────────────────────── 정산주기 규칙 (채널별, 플랫폼 전역) ─────────────────────────

enum SettlementRuleType {
  DAYS   // 후원일 + offsetValue 일 후
  MONTHS // offsetValue 개월 후, anchorDay 일
}

model SettlementRule {
  id          String             @id @default(cuid())
  channel     DonationChannel    @unique
  ruleType    SettlementRuleType @default(MONTHS)
  offsetValue Int                @default(1) // DAYS: 일수 / MONTHS: 개월수
  anchorDay   Int?               // MONTHS 전용: 정산일(1~28). DAYS 에선 무시
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}
